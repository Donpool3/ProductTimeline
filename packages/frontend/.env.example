# Product Timeline Web Application - Environment Configuration

# API Configuration
# Base URL for the backend API
VITE_API_BASE_URL=/api/v1

# Mock Mode Configuration
# Set to 'true' to use mock data instead of real backend
# Set to 'false' to connect to real backend API
VITE_MOCK_MODE=true

# Mock API Delay (milliseconds)
# Simulates network latency for realistic testing
# Set to 0 for instant responses
# Recommended: 300-1000 for realistic simulation
VITE_MOCK_DELAY=500

# Mock Data Configuration
# Number of additional mock projects to generate (beyond warehouse app)
VITE_MOCK_ADDITIONAL_PROJECTS=0

# Mock Data Seed
# Predefined mock data set to use
# Options: 'warehouse-app', 'multi-project', 'minimal'
VITE_MOCK_DATA_SEED=warehouse-app

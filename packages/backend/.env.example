# Product Timeline Backend - Environment Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=timeline
DB_PASSWORD=timeline
DB_DATABASE=timeline_dev

# Database Connection Pool
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Mock Data Configuration
# Set to 'true' to seed database with mock data on startup
SEED_DATABASE=true

# Set to 'true' to clear database before seeding
CLEAR_DATABASE_BEFORE_SEED=false

# Logging
LOG_LEVEL=debug

# File Watching
# Enable file system watching for documentation changes
ENABLE_FILE_WATCHING=false

# File watch paths (comma-separated)
WATCH_PATHS=./docs,./specs

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
